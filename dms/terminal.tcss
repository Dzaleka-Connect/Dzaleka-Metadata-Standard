Screen { background: $background; color: $foreground; }

#topbar {
    height: 1;
    padding: 0 2;
    background: $background;
    align-vertical: middle;
}
#path { width: 1fr; height: 1; color: $text-muted; }
#stats-line { width: auto; height: 1; color: $text-muted; text-align: right; }

#workspace { height: 1fr; }
#sidebar {
    width: 22;
    padding: 1 1 0 1;
    background: $background;
    border-right: solid $panel;
}
.side-label { height: 1; margin: 1 1 0 1; color: $text-muted; }
.nav {
    width: 100%;
    height: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: $text-muted;
    text-align: left;
    content-align: left middle;
    padding: 0 1;
}
.nav:hover { background: $panel; color: $foreground; }
.nav.active {
    background: $primary 12%;
    color: $primary;
    text-style: bold;
}
.nav:focus { color: $foreground; }
#privacy { dock: bottom; margin: 1; height: 4; color: $text-muted; }

#content { padding: 0 1 0 2; }
#heading-row { height: 1; align-vertical: middle; margin: 1 0 0 0; }
#page-title { width: 1fr; height: 1; text-style: bold; color: $primary; }
#page-description { height: 1; color: $text-muted; margin-bottom: 1; }
#category { width: 24; }
Select > SelectCurrent { border: none; background: $surface; }
Select:focus > SelectCurrent { border: none; background: $panel; }

#split { height: 1fr; }
#list-panel { width: 1fr; min-width: 28; margin-right: 1; }
#list-caption { height: 1; color: $text-muted; }
#items { height: 1fr; background: $background; scrollbar-size: 1 1; }
DataTable > .datatable--header { background: $background; color: $text-muted; text-style: none; }
DataTable > .datatable--cursor { background: $primary 14%; color: $foreground; }
DataTable:focus > .datatable--cursor { background: $primary 22%; color: $foreground; text-style: bold; }
DataTable > .datatable--hover { background: $panel; color: $foreground; }
#empty { padding: 2 1; color: $text-muted; height: 1fr; }

#inspector { width: 1fr; min-width: 30; padding: 0 1; }
#item-title { height: auto; max-height: 2; margin-top: 1; color: $foreground; }
#item-meta { height: 1; color: $text-muted; text-overflow: ellipsis; }
#details { height: 1fr; }
ContentSwitcher, TabPane, TabPane > VerticalScroll { height: 1fr; }
TabbedContent TabPane { padding: 1 0; }
Tabs { background: transparent; }
Tab { background: transparent; color: $text-muted; }
Tab.-active { color: $primary; text-style: bold; }
Underline > .underline--bar { color: $primary; background: $panel; }
VerticalScroll { scrollbar-size: 1 1; }
#overview-content, #json-content, #checks-content { height: auto; }

#composer {
    height: 3;
    margin: 0 1 0 1;
    padding: 0 1;
    border: round $panel;
    background: $surface;
    align-vertical: middle;
}
#composer.active { border: round $primary; }
#prompt-mark { width: 2; height: 1; color: $primary; text-style: bold; }
#search { width: 1fr; border: none; background: transparent; padding: 0; }
#search:focus { border: none; }
#composer-meta { width: auto; height: 1; color: $text-muted; text-align: right; padding: 0 1 0 2; }

Footer { background: $background; color: $text-muted; }
FooterKey > .footer-key--key { background: transparent; color: $primary; }

HelpScreen { align: center middle; background: $background 80%; }
#help-dialog {
    width: 72;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    border: round $primary;
    padding: 1 2;
    background: $surface;
}
.dialog-title { height: 2; color: $primary; text-style: bold; }
#help-dialog VerticalScroll { height: auto; max-height: 22; }
#close-help { margin-top: 1; width: 100%; }

.compact #sidebar { display: none; }
.compact #content { padding: 0 1; }
.compact #split { layout: vertical; }
.compact #list-panel { width: 100%; height: 1fr; min-height: 6; margin-right: 0; margin-bottom: 1; }
.compact #inspector { width: 100%; height: 2fr; min-height: 8; }
.compact #composer-meta { display: none; }
.compact #category { width: 20; }
.short #page-description { display: none; }
.short #item-title { margin-top: 0; max-height: 1; }
.short #list-caption { display: none; }
.short #composer { margin-bottom: 0; }
